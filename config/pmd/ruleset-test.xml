<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="SnippetPermission (tests)"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

  <description>
    PMD para los tests (#32): las mismas reglas que ruleset.xml (PMD no deja
    importar un ruleset por ruta relativa), con tres ajustes.
      - UnitTestShouldIncludeAssert: los tests de MockMvc verifican con
        andExpect(...), que PMD no reconoce como assert si no se lo dice.
      - AvoidDuplicateLiterals: en un test se lee mejor la ruta o el header
        escrito en cada pedido que una constante.
      - TestClassWithoutTestCases: TestUsers arma los usuarios de los tests;
        no es una clase de tests.
  </description>

  <rule ref="category/java/errorprone.xml">
    <exclude name="AvoidFieldNameMatchingMethodName" />
    <exclude name="AvoidDuplicateLiterals" />
    <exclude name="TestClassWithoutTestCases" />
  </rule>

  <rule ref="category/java/bestpractices.xml">
    <exclude name="GuardLogStatement" />
    <exclude name="UnitTestShouldIncludeAssert" />
    <exclude name="UnitTestAssertionsShouldIncludeMessage" />
    <exclude name="UnitTestContainsTooManyAsserts" />
  </rule>

  <rule ref="category/java/design.xml/CyclomaticComplexity">
    <properties>
      <property name="classReportLevel" value="80" />
      <property name="methodReportLevel" value="10" />
    </properties>
  </rule>

  <rule ref="category/java/design.xml/NPathComplexity">
    <properties>
      <property name="reportLevel" value="200" />
    </properties>
  </rule>

  <rule ref="category/java/bestpractices.xml/UnitTestShouldIncludeAssert">
    <properties>
      <property name="extraAssertMethodNames" value="andExpect" />
    </properties>
  </rule>

</ruleset>
